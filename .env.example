# Neon pooled connection (application)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Neon direct connection (migrations)
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Generate with: openssl rand -hex 32. Keep this key stable to decrypt R2 settings.
SETTINGS_ENCRYPTION_KEY=""
# Used by pnpm db:seed. Choose a unique password of at least 12 characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional: existing EmailJS contact form. Without these, visitors get a direct-email fallback.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
