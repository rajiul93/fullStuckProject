generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectCategory {
  small
  medium
  large
  personal
}

model Project {
  id                 String          @id @default(cuid())
  title              String
  description        String
  category           ProjectCategory
  githubFrontendLink String?
  githubBackendLink  String?
  clientLink         String?
  serverLink         String?
  tags               String[]
  features           Json
  published          Boolean         @default(true)
  sortOrder          Int             @default(0)
  images             Media[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([published, category, sortOrder])
}

model Media {
  id              String         @id @default(cuid())
  url             String
  key             String?        @unique
  name            String
  sortOrder       Int            @default(0)
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  storageConfigId String?
  storageConfig   StorageConfig? @relation(fields: [storageConfigId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([projectId, sortOrder])
}

// Each saved version retains the credentials needed to clean up its own uploads.
model StorageConfig {
  id              String   @id @default(cuid())
  accountId       String
  bucket          String
  publicUrl       String
  accessKeyId     String
  secretAccessKey String
  media           Media[]
  createdAt       DateTime @default(now())
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  sessions     Session[]
}

model Session {
  tokenHash String   @id
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model LoginAttempt {
  identifier String   @id
  count      Int      @default(1)
  startedAt  DateTime @default(now())
}
